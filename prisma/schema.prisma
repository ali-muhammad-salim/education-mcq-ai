// ==================================================
// 16. USER & AUTHENTICATION SYSTEM
// ==================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  ownedStudyNotes StudyNote[] @relation("StudyOwner")
  reviewedStudyNotes StudyNote[] @relation("StudyReviewer")
  knowledgeDocuments KnowledgeDocument[]
  reviewedKnowledge KnowledgeArtifact[]
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  passwordHash    String?
  role            UserRole       @default(STUDENT)
  status          AccountStatus  @default(ACTIVE)
  emailVerified   Boolean        @default(false)
  googleId        String?        @unique
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions             UserSession[]
  teacherClassrooms    Classroom[]            @relation("TeacherClassrooms")
  classroomMemberships ClassroomMembership[]
  teacherQuizzes       Quiz[]                 @relation("TeacherQuizzes")
  quizAttempts         QuizAttempt[]
  gradedAnswers        AnswerGrade[]          @relation("TeacherGradedAnswers")
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ==================================================
// 17. CLASSROOM & ENROLLMENT SYSTEM
// ==================================================

model Classroom {
  id          String   @id @default(uuid())
  teacherId   String
  name        String
  description String?
  boardId     String?
  classLevel  Int      // 9, 10, 11, 12
  session     String?  // e.g., "2025-2026"
  code        String   @unique
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User                  @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  memberships ClassroomMembership[]
  quizzes     QuizAssignment[]

  @@index([teacherId])
  @@index([code])
}

model ClassroomMembership {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String
  status      String   @default("ENROLLED") // ENROLLED, INVITED, REMOVED
  enrolledAt  DateTime @default(now())

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
}

// ==================================================
// 18. QUIZ & ASSESSMENT SYSTEM
// ==================================================

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuizVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AIGradingMode {
  OFF
  LENIENT
  MEDIUM
  STRICT
  CUSTOM
}

model Quiz {
  id             String         @id @default(uuid())
  code           String?        @unique
  teacherId      String
  title          String
  description    String?        @db.Text
  boardId        String?
  classId        String?
  subjectId      String?
  totalMarks     Float          @default(0)
  durationMin    Int?
  status         QuizStatus     @default(DRAFT)
  visibility     QuizVisibility @default(PUBLIC)
  scheduleStart  DateTime?
  scheduleEnd    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher        User             @relation("TeacherQuizzes", fields: [teacherId], references: [id])
  settings       QuizSetting?
  questions      QuizQuestion[]
  attempts       QuizAttempt[]
  assignments    QuizAssignment[]

  @@index([teacherId])
  @@index([status])
  @@index([visibility])
}

model QuizSetting {
  id                    String        @id @default(uuid())
  quizId                String        @unique
  maxAttempts           Int           @default(1)
  allowRetries          Boolean       @default(false)
  randomizeQuestions    Boolean       @default(false)
  randomizeOptions      Boolean       @default(false)
  immediateFeedback     Boolean       @default(true)
  showCorrectAnswers    Boolean       @default(true)
  resultVisibility      String        @default("IMMEDIATE") // IMMEDIATE, MANUAL_RELEASE, SCHEDULED
  resultReleaseDate     DateTime?
  manualGradingRequired Boolean       @default(false)
  aiGradingMode         AIGradingMode @default(MEDIUM)
  customRubric          Json?
  negativeMarking       Boolean       @default(false)
  negativeMarkValue     Float         @default(0)
  tabMonitoringEnabled  Boolean       @default(true)
  tabWarningThreshold   Int           @default(2)
  lateSubmissionAllowed Boolean       @default(false)

  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAssignment {
  id          String    @id @default(uuid())
  quizId      String
  classroomId String
  assignedAt  DateTime  @default(now())
  deadline    DateTime?

  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([quizId, classroomId])
}

model QuizQuestion {
  id                 String    @id @default(uuid())
  quizId             String
  bankQuestionId     String?
  orderIndex         Int
  marks              Float     @default(1)
  isRequired         Boolean   @default(true)
  questionData       Json

  quiz               Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers            QuizAnswer[]

  @@index([quizId])
  @@index([orderIndex])
}

// ==================================================
// 19. ATTEMPTS & ASSESSMENT ENGINE
// ==================================================

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  GRADING_PENDING
  GRADED
}

model QuizAttempt {
  id              String        @id @default(uuid())
  quizId          String
  studentId       String
  attemptNumber   Int           @default(1)
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  deadline        DateTime
  submittedAt     DateTime?
  totalScore      Float?
  autoScore       Float?
  manualScore     Float?
  tabSwitchCount  Int           @default(0)
  ipAddress       String?
  userAgent       String?
  questionSnapshot Json?

  quiz            Quiz          @relation(fields: [quizId], references: [id])
  student         User          @relation(fields: [studentId], references: [id])
  answers         QuizAnswer[]
  events          AssessmentEvent[]

  @@index([quizId])
  @@index([studentId])
  @@index([status])
  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId, studentId, status])
}

model AIDoubtRecord {
  id         String   @id @default(uuid())
  ownerId    String
  status     String   @default("PENDING_REVIEW")
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([ownerId, status, createdAt])
}

model DurableJob {
  id          String   @id @default(uuid())
  ownerId     String
  kind        String
  status      String   @default("QUEUED")
  payload     Json
  result      Json?
  error       String?
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lockedAt    DateTime?
  leaseToken  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, availableAt])
  @@index([ownerId, createdAt])
}

enum KnowledgeReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model KnowledgeDocument {
  id                String @id @default(uuid())
  ownerId           String
  subjectId         String
  syllabusVersionId String?
  sha256            String
  storageKey        String
  resourceType      String
  status            String @default("PROCESSING")
  totalPages        Int
  pipelineVersion   String
  autoStudyResources Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject           Subject @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  syllabusVersion   SyllabusVersion? @relation(fields: [syllabusVersionId, subjectId], references: [id, subjectId], onDelete: NoAction, onUpdate: NoAction)
  artifacts         KnowledgeArtifact[]
  references        KnowledgeReference[] @relation("KnowledgeSource")
  referencedBy      KnowledgeReference[] @relation("KnowledgeReference")
  studyNotes        StudyNote[]
  @@unique([id, syllabusVersionId])
  @@unique([sha256, subjectId, resourceType, pipelineVersion], map: "KnowledgeDocument_source_scope_key")
  @@index([subjectId, syllabusVersionId, status], map: "KnowledgeDocument_scope_idx")
}

model KnowledgeReference {
  documentId  String
  referenceId String
  kind        String
  document    KnowledgeDocument @relation("KnowledgeSource", fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reference   KnowledgeDocument @relation("KnowledgeReference", fields: [referenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([documentId, referenceId])
}

model KnowledgeArtifact {
  id                   String @id @default(uuid())
  documentId           String
  pageNumber           Int
  content              String @db.Text
  contentHash          String
  data                 Json
  sourceImageKey       String
  status               KnowledgeReviewStatus @default(PENDING_REVIEW)
  reviewerId           String?
  reviewedAt           DateTime?
  reviewNote           String? @db.Text
  embedding            Unsupported("vector(768)")?
  embeddingModel       String?
  embeddingContentHash String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  document             KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer             User? @relation(fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studyCitations       StudyNoteSource[]
  @@unique([documentId, pageNumber])
  @@index([status, createdAt])
}

model AIProviderBudget {
  id        String @id
  requests  Int @default(0)
  tokens    Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model AIProviderState {
  id            String @id
  disabled      Boolean @default(false)
  cooldownUntil DateTime?
}

model WorkerHeartbeat {
  id       String @id
  kinds    String[]
  seenAt   DateTime
  @@index([seenAt])
}

model AuthChallenge {
  identifier String   @id
  codeHash   String
  name       String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model RequestLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model LegacyArchive {
  id        String   @id
  kind      String
  data      Json
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}

model QuizAnswer {
  id             String       @id @default(uuid())
  attemptId      String
  questionId     String
  answerPayload  Json
  version        Int          @default(1)
  isAutoGraded   Boolean      @default(false)
  score          Float?
  teacherComment String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradeRecords   AnswerGrade[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AssessmentEvent {
  id         String   @id @default(uuid())
  attemptId  String
  eventType  String
  timestamp  DateTime @default(now())
  metadata   Json?

  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
}

model AnswerGrade {
  id             String       @id @default(uuid())
  quizAnswerId   String
  graderId       String?
  isAiGraded     Boolean      @default(false)
  aiMode         AIGradingMode?
  awardedMarks   Float
  maxMarks       Float
  feedback       String?      @db.Text
  rubricScores   Json?
  confidence     Float?
  status         String       @default("FINAL")
  createdAt      DateTime     @default(now())

  quizAnswer     QuizAnswer   @relation(fields: [quizAnswerId], references: [id], onDelete: Cascade)
  grader         User?        @relation("TeacherGradedAnswers", fields: [graderId], references: [id])

  @@index([quizAnswerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
}
