# ==============================================================================
# EDUCATIONAL RESOURCE HUB & SECURE ASSESSMENT PLATFORM (.env.example)
# ==============================================================================
# This file documents all environment variables used across the platform.
# For local development, limited fallbacks (private local disk storage,
# database Prisma search) are available. Authentication has no demo bypasses.
# ==============================================================================

# 1. DATABASE (Required)
# PostgreSQL connection string with pgvector extension support
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcqs"

# 2. AI GENERATION & RAG (Active)
# Google Gemini API keys used for question generation, RAG, and MCQ parsing
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL=""

# 3. AUTHENTICATION & GOOGLE OAUTH (Optional for local, required for Google Sign-In)
# Accounts use passwords or verified OAuth. Educator roles require administrator approval.
# To connect Google OAuth: Create Web Client credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (and your production domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="generate-a-secure-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# 4. TRANSACTIONAL EMAIL (Optional for local, required for live student delivery)
# Service: Resend (https://resend.com)
# Missing delivery credentials return a failure; OTP codes are never returned or logged.
# To connect: Sign up at resend.com, generate an API key, and verify your sending domain.
RESEND_API_KEY=""
EMAIL_FROM="assessments@akueb-portal.edu.pk"

# 5. MONITORING & ERROR TRACKING (Optional for local, required for production APM)
# Service: Sentry (https://sentry.io)
# Tracks unhandled exceptions, slow SQL queries, and API 500 errors.
# To connect: Run `npx @sentry/wizard@latest -i nextjs` or add your project DSN.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# 6. PRODUCT TELEMETRY & PRIVACY-SCRUBBED ANALYTICS (Optional)
# Service: PostHog (https://posthog.com) or Google Analytics (GA4)
# lib/analytics.ts automatically scrubs passwords, student answers, and question keys.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
NEXT_PUBLIC_GA_ID=""

# 7. CLOUD OBJECT STORAGE (Optional for local, required for production serverless)
# Service: Cloudflare R2 / AWS S3
# Local files use private data/assets. Production requires R2 or a persistent ASSET_ROOT.
# To connect: Create a bucket in Cloudflare R2 dashboard, generate S3 API credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="education-mcq-hub"
R2_PUBLIC_DOMAIN=""

# 8. FULL-TEXT SEARCH (Optional for local, recommended for >5,000 questions)
# Service: Typesense (https://typesense.org)
# When omitted, lib/typesense.ts automatically falls back to PostgreSQL Prisma full-text search.
TYPESENSE_HOST=""
TYPESENSE_API_KEY=""
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"

# Hardening deployment settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Server-only canonical origin, read at runtime by the Docker container.
APP_URL="http://localhost:3000"
SESSION_SECRET=""
# Comma-separated models supported by your Google account; no obsolete fallback is assumed.
GEMINI_MODELS=""
# A persistent shared path used by web and ingestion workers when R2 is absent.
ASSET_ROOT=""
PYTHON_EXECUTABLE="python"
# Run a separate deadline worker with WORKER_KINDS=EXAM_FINALIZE.
WORKER_KINDS="EXAM_FINALIZE,EXAM_GRADE"
# Keep synchronous until a grading worker is deployed and verified, then set queued.
ASSESSMENT_SUBMISSION_MODE="synchronous"
# Initial settings for a shared 4-vCPU/8-GB host; measure before increasing.
ASSESSMENT_MAX_IN_FLIGHT="8"
ASSESSMENT_MAX_WAITING="128"
# Add ?connection_limit=10&pool_timeout=10 to the web DATABASE_URL.
# Use a separate worker environment with connection_limit=3&pool_timeout=10.
# Python API is private; use a random token of at least 32 characters.
INTERNAL_API_TOKEN=""
INTERNAL_SERVICE_USER_ID=""
CORS_ORIGINS="http://localhost:3000"
# Set temporarily when explicitly provisioning/resetting an administrator.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Tests only; must identify a separate database with _test in its name.
TEST_DATABASE_URL=""
