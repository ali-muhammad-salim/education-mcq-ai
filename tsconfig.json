{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "services/**/*.ts",
    "repositories/**/*.ts",
    "tests/**/*.ts",
    "scripts/job-worker.ts",
    "scripts/bootstrap-admin.ts",
    "scripts/archive-legacy.ts",
    "vitest.config.ts",
    "scripts/db-preflight.ts",
    "scripts/rehearse-ai-trust.ts",
    "scripts/rehearse-study-library.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "student-web"
  ]
}
