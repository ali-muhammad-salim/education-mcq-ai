# Isolated AI/document worker. Assessment workers keep their own runtime/budget.
FROM node:22-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates python3 python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/pdf-runtime && /opt/pdf-runtime/bin/pip install --no-cache-dir PyMuPDF==1.28.2
COPY package.json package-lock.json ./
COPY prisma ./prisma/
RUN npm ci --ignore-scripts && npx prisma generate --generator client
COPY lib ./lib
COPY repositories ./repositories
COPY services ./services
COPY scripts/job-worker.ts ./scripts/job-worker.ts
COPY tsconfig.json ./tsconfig.json
ENV NODE_ENV=production
ENV PYTHON_EXECUTABLE=/opt/pdf-runtime/bin/python
ENV WORKER_KINDS=AI_GENERATION,INGESTION,AI_EMBEDDING,STUDY_GENERATION
ENV NODE_OPTIONS=--max-old-space-size=512
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 -g nodejs worker && mkdir -p /app/data/assets /app/data/jobs && chown worker:nodejs /app/data/assets /app/data/jobs
USER worker
CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/job-worker.ts"]
