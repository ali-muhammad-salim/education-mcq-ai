    "PHY-XI-2024-P2": [
      {
        "number": 1,
        "page": 2,
        "marks": 3,
        "stem": "The weight of a student on a certain weighing scale measures about 55 kg.\nIf the least count of the machine is 0.5 kg, then calculate the percentage uncertainty in the measurement.",
        "choices": {},
        "facsimile": "/paper-crops/PHY-XI-2024-P2/q1.png",
        "diagram": null
      },
      {
        "number": 2,
        "page": 2,
        "marks": 2,
        "stem": "Write any TWO physical quantities that exemplify each of the following.\n\n| S. No. | Scalar Product | S. No. | Vector Product |\n| --- | --- | --- | --- |\n| 1 |  | 1 |  |\n| 2 |  | 2 |  |",
        "choices": {},
